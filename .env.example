# Copy to `.env`. That file is gitignored — never commit real keys or a filled `.env` to Git.
# Together.ai Project API key (prefer saving via Instructor → Together.ai credentials; avoids plaintext disks).
# Fallback / CI / Docker: uncomment and set below.
TOGETHER_API_KEY=

# The app always uses the built-in recommended fast model (openai/gpt-oss-20b) unless you opt in below.
# To use a custom Together chat model for every call, set TOGETHER_USE_ENV_MODEL=1 and set TOGETHER_MODEL to the API string
# (see https://docs.together.ai/docs/inference-models).
# TOGETHER_USE_ENV_MODEL=1
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Default server behavior; you can still pick Mock vs Production per exam on the home page.
# 1 = default to mock when opening the app; 0 = default to production when an API key is present.
MOCK_LLM=0

# Instructor dashboard: signing key for the session cookie (use a long random string in production).
# INSTRUCTOR_SESSION_SECRET=
# INSTRUCTOR_SESSION_HTTPS_ONLY=1

# Production hardening (refuses default secrets and missing agent secret when analysis URL is set).
# RGEE_PRODUCTION=1
# RGEE_CSRF_ENABLED=1

# Optional: JSON path with one-way derived secrets (created on first run as instructor_credentials.json).
# INSTRUCTOR_CREDENTIALS_PATH=

# Optional overrides if you do not use a credentials file (hex SHA-256 of username UTF-8 bytes;
# hex PBKDF2-HMAC-SHA256 digest with salt "rgee-instructor-v1" and 210000 iterations).
# INSTRUCTOR_USERNAME_SHA256=
# INSTRUCTOR_PASSWORD_PBKDF2_HEX=

# Optional: override directory for AES-encrypted Together key fallback files (writable mount in containers).
# RGEE_CREDENTIAL_DATA_DIR=

# --- RGEE_Analysis_Agent (parallel scoring service, optional) ---
# When RGEE_ANALYSIS_AGENT_URL is set (e.g. http://127.0.0.1:8010), the instructor question-analysis
# page delegates embedding work to that separate process. Leave unset to score in-process (tests / simple setups).
# RGEE_ANALYSIS_AGENT_URL=http://127.0.0.1:8010
# Optional shared secret; must match RGEE_ANALYSIS_AGENT_SECRET in the agent's environment.
# RGEE_ANALYSIS_AGENT_SECRET=
# RGEE_ANALYSIS_AGENT_REQUIRE_SECRET=1
# RGEE_ANALYSIS_AGENT_TIMEOUT_S=600
